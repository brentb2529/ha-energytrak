{
  "config": {
    "step": {
      "user": {
        "title": "EnergyTrak",
        "description": "Set up an EnergyTrak cloud account, a local B-Infohub RS-485 bridge, or both. You can add the other half later.",
        "menu_options": {
          "cloud": "EnergyTrak cloud account",
          "bridge_manual": "Local B-Infohub bridge (enter address)"
        }
      },
      "sites": {
        "title": "Choose generators",
        "description": "Select the EnergyTrak sites to add. If none are listed, your account cannot browse the site list — enter the site IDs manually instead.",
        "data": {
          "site_ids": "Sites",
          "manual_site_ids": "Additional site IDs"
        },
        "data_description": {
          "manual_site_ids": "Comma-separated site IDs."
        }
      },
      "reauth_confirm": {
        "title": "Reconnect EnergyTrak",
        "description": "The saved credentials for {email} are no longer valid. Request a new sign-in link and paste it below.",
        "data": {
          "magic_link": "Sign-in link"
        }
      },
      "reconfigure": {
        "title": "Update EnergyTrak sign-in",
        "description": "Replace the stored credentials for {email}. Request a fresh sign-in link from the EnergyTrak app or website and paste it below. Do this whenever you sign in elsewhere, since a new sign-in can invalidate the token Home Assistant is using. The link is single-use — do not open it in a browser first.",
        "data": {
          "email": "Email address",
          "magic_link": "Sign-in link"
        },
        "data_description": {
          "email": "Must be the same EnergyTrak account; to add a different account, add another integration entry.",
          "magic_link": "Copy the link target from the email (right-click the sign-in button → Copy link address)."
        }
      },
      "bridge": {
        "title": "B-Infohub local bridge",
        "description": "Found {name} at {host}.\n\nThis bridge reads the generator's RS-485 port directly, so it reports roughly twice as many values as the EnergyTrak cloud and updates every few seconds instead of every few hours. It will be used automatically whenever it is reachable AND its bus is healthy; EnergyTrak keeps polling underneath and takes over the moment it is not.\n\nEnter the bridge's API encryption key (api_encryption_key in its secrets.yaml).",
        "data": {
          "local_encryption_key": "API encryption key",
          "local_site_id": "Which generator is it wired to?"
        }
      },
      "cloud": {
        "title": "Sign in to EnergyTrak",
        "description": "Request a sign-in link at {domain}, then paste the whole link here along with the email address you requested it for.",
        "data": {
          "email": "Email address",
          "magic_link": "Sign-in link"
        }
      },
      "bridge_manual": {
        "title": "Local B-Infohub bridge",
        "description": "Enter the bridge's address and its API encryption key (api_encryption_key in its secrets.yaml). Use this when mDNS discovery cannot reach it — for example when the generator is on its own VLAN.",
        "data": {
          "local_host": "Host or IP address",
          "local_port": "Port",
          "local_encryption_key": "API encryption key"
        }
      }
    },
    "error": {
      "cannot_connect": "Failed to connect to EnergyTrak.",
      "invalid_auth": "EnergyTrak rejected the sign-in.",
      "invalid_magic_link": "That does not look like a sign-in link — it must contain apiKey and oobCode parameters.",
      "expired_link": "That sign-in link has expired or was already used. Request a new one.",
      "email_mismatch": "The link does not match that email address.",
      "no_sites_selected": "Select at least one site, or enter a site ID manually.",
      "unknown": "Unexpected error.",
      "invalid_key": "The bridge rejected that encryption key."
    },
    "abort": {
      "already_configured": "This EnergyTrak account is already set up.",
      "reauth_successful": "EnergyTrak reconnected successfully.",
      "reconfigure_successful": "EnergyTrak credentials updated.",
      "account_mismatch": "That sign-in link belongs to a different EnergyTrak account. Use the original account, or add a new integration entry for the other one.",
      "not_b_infohub": "That device is not a B-Infohub bridge.",
      "bridge_added": "Local bridge added. It will be used whenever its RS-485 bus is healthy."
    }
  },
